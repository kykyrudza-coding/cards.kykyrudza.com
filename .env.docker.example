# Server / prod behind Traefik (docker-compose.prod.yml)
# Copy to .env.docker and fill in real values before running `make sync`.

# Must match REVERB_APP_KEY in backend/.env exactly (Reverb rejects the
# frontend's WebSocket connection otherwise).
REVERB_APP_KEY=

# Optional — defaults to "poker" (fine for a friends-only game, but change
# it if you'd rather not use the dev default).
POSTGRES_PASSWORD=
